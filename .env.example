# Supabase Credentials (Public client side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Server-only operations & migrations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI API Key (Optional - application falls back to local deterministic analyzer if omitted)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# App URL Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode Toggle (Forces mock database / seed mode when Supabase is unconfigured)
NEXT_PUBLIC_DEMO_MODE=true
